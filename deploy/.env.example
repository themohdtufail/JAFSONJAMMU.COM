# Copy to deploy/.env on the server. Never commit the real file.
POSTGRES_PASSWORD=            # openssl rand -hex 24
TUNNEL_TOKEN=                 # Cloudflare Zero Trust > Networks > Tunnels > jafson > token

JWT_SECRET=                   # openssl rand -hex 48
MFA_ENCRYPTION_KEY=           # openssl rand -hex 32
ADMIN_API_KEY=                # leave EMPTY in production: the service key bypasses two-step login
BILL_OS_API_KEY=              # openssl rand -hex 32 (when Bill OS is connected)
PAYMENT_WEBHOOK_SECRET=       # openssl rand -hex 32 (unused with Razorpay; keep non-empty)
REQUIRE_ADMIN_MFA=1
CORS_ORIGINS=

# First owner account (created by the migrate step; remove both after signing in and enabling two-step login)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
SEED_CATALOGUE=0              # 1 loads the 16 demo products with stock photos

# Razorpay: use rzp_test_ keys until the go-live checks in docs/architecture/payments.md pass
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Printed on invoices. With SELLER_GSTIN set, dispatch needs an HSN code on every product (docs/architecture/gst.md)
SELLER_LEGAL_NAME=Chameron Industries Private Limited
SELLER_GSTIN=
SELLER_CIN=
SELLER_ADDRESS=
