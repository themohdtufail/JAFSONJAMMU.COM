DATABASE_URL=postgresql://user:pass@localhost:5432/jafson
JWT_SECRET=
ADMIN_API_KEY=
BILL_OS_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# Dev only: mock payment provider and echoing the OTP in the response (no SMS provider yet).
PAYMENTS_MOCK=0
OTP_DEV_ECHO=0
PORT=4000
# First owner account, created by db:seed. Use a strong password and remove after first login.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Payments (Razorpay). Use test keys first (rzp_test_...), live keys only after go-live checks. ---
# PAYMENTS_PROVIDER=razorpay uses Razorpay; "mock" is a development stand-in and must never be used in production.
PAYMENTS_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Security ---
# Two-step login (authenticator app) for managers and owners. On by default when NODE_ENV=production.
REQUIRE_ADMIN_MFA=
# Optional separate key for encrypting authenticator secrets at rest (falls back to a key derived from JWT_SECRET).
MFA_ENCRYPTION_KEY=
# Comma-separated browser origins allowed to call the API directly. The storefront and back-office call it through their own
# /api proxy, so production usually needs none.
CORS_ORIGINS=
# Set to 1 when the API runs behind a load balancer or proxy so rate limits use the real client IP.
TRUST_PROXY=0
# Requests per minute per client IP. RATE_LIMIT=0 turns limiting off (never in production).
RATE_LIMIT=1
RATE_LIMIT_AUTH=20
RATE_LIMIT_ORDERS=40
RATE_LIMIT_DEFAULT=600

# --- Invoice seller details (printed on customer invoices). Leave GSTIN empty until the company's registration is confirmed:
# invoices then say "Order invoice" instead of "Tax invoice". ---
SELLER_LEGAL_NAME=Chameron Industries Private Limited
SELLER_GSTIN=
SELLER_CIN=
SELLER_ADDRESS=
# Shared with the shop and back-office so the API can trust the visitor IP they forward. TRUST_PROXY = number of proxies in front of the API (0 = none).
INTERNAL_PROXY_SECRET=
LOOKUP_FAIL_LIMIT_PHONE=10
LOOKUP_FAIL_LIMIT_IP=40
