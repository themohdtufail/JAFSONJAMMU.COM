// JAFSON Commerce schema. Money is integer paise. Timestamps are UTC.
// DB-level invariants Prisma cannot express live in SQL migrations under prisma/migrations (see 20261114000002_integrity_rules).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  cart                Cart?
  wishlist            WishlistItem[]
  id                  String         @id @default(uuid()) @db.Uuid
  phone               String         @unique
  name                String?
  email               String?        @unique
  status              String         @default("ACTIVE")
  deletionRequestedAt DateTime?      @db.Timestamptz
  createdAt           DateTime       @default(now()) @db.Timestamptz
  updatedAt           DateTime       @updatedAt @db.Timestamptz
  addresses           Address[]
  orders              Order[]
  refreshTokens       RefreshToken[]
}

model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime  @db.Timestamptz
  consumedAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz

  @@index([phone, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id])
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id])
}

model Category {
  id         String    @id @default(uuid()) @db.Uuid
  slug       String    @unique
  name       String
  collection String
  sortOrder  Int       @default(0)
  products   Product[]
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique
  name        String
  brand       String           @default("Jafson")
  description String
  collection  String
  categoryId  String           @db.Uuid
  fabric      String
  fit         String
  gstRateBps  Int              @default(500)
  hsnCode     String?
  status      String           @default("ACTIVE")
  isNew       Boolean          @default(false)
  isBest      Boolean          @default(false)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now()) @db.Timestamptz
  updatedAt   DateTime         @updatedAt @db.Timestamptz
  category    Category         @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  wishlisted  WishlistItem[]

  @@index([collection, status])
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  url       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id             String                 @id @default(uuid()) @db.Uuid
  productId      String                 @db.Uuid
  sku            String                 @unique
  barcode        String?                @unique
  colourName     String
  colourHex      String
  size           String
  pricePaise     Int
  compareAtPaise Int?
  costPricePaise Int                    @default(0)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now()) @db.Timestamptz
  product        Product                @relation(fields: [productId], references: [id])
  balances       InventoryBalance[]
  movements      InventoryMovement[]
  reservations   InventoryReservation[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
}

model InventoryLocation {
  id       String             @id @default(uuid()) @db.Uuid
  code     String             @unique
  name     String
  isActive Boolean            @default(true)
  balances InventoryBalance[]
}

model InventoryBalance {
  id          String            @id @default(uuid()) @db.Uuid
  locationId  String            @db.Uuid
  variantId   String            @db.Uuid
  onHand      Int               @default(0)
  reserved    Int               @default(0)
  safetyStock Int               @default(0)
  version     Int               @default(0)
  updatedAt   DateTime          @updatedAt @db.Timestamptz
  location    InventoryLocation @relation(fields: [locationId], references: [id])
  variant     ProductVariant    @relation(fields: [variantId], references: [id])

  @@unique([locationId, variantId])
}

model InventoryMovement {
  id             String         @id @default(uuid()) @db.Uuid
  locationId     String         @db.Uuid
  variantId      String         @db.Uuid
  movementType   String
  quantityDelta  Int
  referenceType  String
  referenceId    String
  idempotencyKey String         @unique
  sourceSystem   String
  actor          String?
  reason         String?
  createdAt      DateTime       @default(now()) @db.Timestamptz
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, createdAt])
}

model InventoryReservation {
  id         String         @id @default(uuid()) @db.Uuid
  orderId    String         @db.Uuid
  variantId  String         @db.Uuid
  locationId String         @db.Uuid
  quantity   Int
  status     String         @default("ACTIVE")
  expiresAt  DateTime?      @db.Timestamptz
  createdAt  DateTime       @default(now()) @db.Timestamptz
  order      Order          @relation(fields: [orderId], references: [id])
  variant    ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([status, expiresAt])
}

model Order {
  id                String                 @id @default(uuid()) @db.Uuid
  number            String                 @unique
  userId            String?                @db.Uuid
  status            String
  paymentStatus     String
  paymentMethod     String
  fulfilmentType    String
  subtotalPaise     Int
  shippingPaise     Int
  codFeePaise       Int                    @default(0)
  discountPaise     Int                    @default(0)
  couponCode        String?
  taxPaise          Int
  placeOfSupplyCode String                 @default("01")
  buyerGstin        String?
  buyerBusinessName String?
  totalPaise        Int
  contactName       String
  contactPhone      String
  contactEmail      String?
  shippingAddress   Json
  idempotencyKey    String                 @unique
  pickupCode        String?
  expiresAt         DateTime?              @db.Timestamptz
  deliveredAt       DateTime?              @db.Timestamptz
  createdAt         DateTime               @default(now()) @db.Timestamptz
  updatedAt         DateTime               @updatedAt @db.Timestamptz
  user              User?                  @relation(fields: [userId], references: [id])
  items             OrderItem[]
  history           OrderStatusHistory[]
  payments          Payment[]
  reservations      InventoryReservation[]
  returns           ReturnRequest[]
  invoice           Invoice?
  creditNotes       CreditNote[]
  pickup            PickupConfirmation?
  redemption        CouponRedemption?
  shipments         Shipment[]
  notes             OrderNote[]

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([contactPhone])
}

model OrderItem {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @db.Uuid
  variantId      String         @db.Uuid
  sku            String
  productName    String
  colour         String
  size           String
  imageUrl       String?
  quantity       Int
  unitPricePaise Int
  taxPaise       Int
  discountPaise  Int            @default(0)
  gstRateBps     Int            @default(500)
  hsnCode        String?
  lineTotalPaise Int
  order          Order          @relation(fields: [orderId], references: [id])
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  returnItems    ReturnItem[]
}

model OrderStatusHistory {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  fromStatus String?
  toStatus   String
  actor      String
  note       String?
  createdAt  DateTime @default(now()) @db.Timestamptz
  order      Order    @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
}

model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @db.Uuid
  provider          String
  providerRef       String   @unique
  providerPaymentId String?  @unique
  method            String?
  amountPaise       Int
  status            String
  createdAt         DateTime @default(now()) @db.Timestamptz
  order             Order    @relation(fields: [orderId], references: [id])
  refunds           Refund[]

  @@index([orderId])
}

model Refund {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @db.Uuid
  paymentId        String   @db.Uuid
  providerRefundId String?  @unique
  amountPaise      Int
  status           String   @default("PENDING")
  reason           String?
  actor            String
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz
  payment          Payment  @relation(fields: [paymentId], references: [id])

  @@index([orderId])
}

model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String    @unique
  payload     Json
  processedAt DateTime? @db.Timestamptz
  createdAt   DateTime  @default(now()) @db.Timestamptz
}

model ReturnRequest {
  id         String       @id @default(uuid()) @db.Uuid
  ref        String       @unique
  orderId    String       @db.Uuid
  status     String       @default("REQUESTED")
  receivedAt DateTime?    @db.Timestamptz
  restocked  Boolean      @default(false)
  createdAt  DateTime     @default(now()) @db.Timestamptz
  order      Order        @relation(fields: [orderId], references: [id])
  items      ReturnItem[]
}

model ReturnItem {
  id           String        @id @default(uuid()) @db.Uuid
  returnId     String        @db.Uuid
  orderItemId  String        @db.Uuid
  kind         String
  reason       String
  exchangeSize String?
  returnReq    ReturnRequest @relation(fields: [returnId], references: [id])
  orderItem    OrderItem     @relation(fields: [orderItemId], references: [id])
}

model ServiceablePincode {
  id           String  @id @default(uuid()) @db.Uuid
  pincode      String  @unique
  deliveryType String
  feePaise     Int
  codAllowed   Boolean @default(true)
}

model IntegrationEventInbox {
  id               String    @id @default(uuid()) @db.Uuid
  eventId          String    @unique
  eventType        String
  sourceSystem     String
  payload          Json
  status           String
  quarantineReason String?
  detail           String?
  attempts         Int       @default(1)
  receivedAt       DateTime  @default(now()) @db.Timestamptz
  processedAt      DateTime? @db.Timestamptz

  @@index([status])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actor     String
  action    String
  entity    String
  entityId  String
  data      Json?
  createdAt DateTime @default(now()) @db.Timestamptz
}

model StaffUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("STAFF")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz
  mfaSecretEnc String?
  mfaEnabledAt DateTime? @db.Timestamptz
  mfaLastStep  Int?
  createdAt    DateTime  @default(now()) @db.Timestamptz
}

/// A GST tax invoice. Issued once per order at dispatch or collection, never edited afterwards (database trigger).
model Invoice {
  id                String       @id @default(uuid()) @db.Uuid
  number            String       @unique
  financialYear     String
  orderId           String       @unique @db.Uuid
  issuedAt          DateTime     @default(now()) @db.Timestamptz
  issuedBy          String
  sellerName        String
  sellerGstin       String
  sellerAddress     String
  sellerStateCode   String
  buyerName         String
  buyerGstin        String?
  buyerBusinessName String?
  billingAddress    Json
  placeOfSupplyCode String
  supply            String
  lines             Json
  taxablePaise      Int
  cgstPaise         Int
  sgstPaise         Int
  igstPaise         Int
  totalPaise        Int
  order             Order        @relation(fields: [orderId], references: [id])
  creditNotes       CreditNote[]

  @@index([issuedAt])
}

/// A GST credit note against an invoice, issued for refunds. Immutable like the invoice.
model CreditNote {
  id            String   @id @default(uuid()) @db.Uuid
  number        String   @unique
  financialYear String
  invoiceId     String   @db.Uuid
  orderId       String   @db.Uuid
  refundId      String?  @unique @db.Uuid
  reason        String
  issuedAt      DateTime @default(now()) @db.Timestamptz
  issuedBy      String
  lines         Json
  taxablePaise  Int
  cgstPaise     Int
  sgstPaise     Int
  igstPaise     Int
  totalPaise    Int
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  order         Order    @relation(fields: [orderId], references: [id])

  @@index([issuedAt])
}

/// Gapless counters, one row per document type and financial year. Incremented inside the issuing transaction.
model DocumentSequence {
  key  String @id
  next Int    @default(1)
}

/// Proof that a showroom pickup was handed over (spec 3.10 #10). A database trigger refuses COLLECTED without one.
model PickupConfirmation {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @unique @db.Uuid
  verifiedBy String
  verifiedAt DateTime @default(now()) @db.Timestamptz
  order      Order    @relation(fields: [orderId], references: [id])
}

/// Shared fixed-window counters for limits that must hold across API instances (lookup abuse). Rows expire by resetAt.
model RateCounter {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @db.Timestamptz
}

/// One row per snapshot the showroom submitted: what the ledger said, what the showroom counted, and the differences. Reported, never auto-applied.
model StockReconciliation {
  id               String   @id @default(uuid()) @db.Uuid
  eventId          String   @unique
  locationId       String   @db.Uuid
  checked          Int
  discrepancyCount Int
  discrepancies    Json
  createdAt        DateTime @default(now()) @db.Timestamptz

  @@index([createdAt])
}

/// Last time an integration was heard from. While the POS is silent an extra safety buffer is applied to online availability (spec 4.5).
model IntegrationHeartbeat {
  source     String   @id
  lastSeenAt DateTime @db.Timestamptz
}

model Coupon {
  id               String             @id @default(uuid()) @db.Uuid
  code             String             @unique
  description      String
  kind             String // PERCENT (value in basis points) or FLAT (value in paise)
  value            Int
  minSubtotalPaise Int                @default(0)
  maxDiscountPaise Int?
  startsAt         DateTime?          @db.Timestamptz
  endsAt           DateTime?          @db.Timestamptz
  usageLimit       Int?
  perPhoneLimit    Int                @default(1)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now()) @db.Timestamptz
  redemptions      CouponRedemption[]
}

/// One row per order that used a coupon. Released (not deleted) when the order is cancelled or expires, so the use is given back and the history stays.
model CouponRedemption {
  id            String    @id @default(uuid()) @db.Uuid
  couponId      String    @db.Uuid
  orderId       String    @unique @db.Uuid
  phone         String
  discountPaise Int
  createdAt     DateTime  @default(now()) @db.Timestamptz
  releasedAt    DateTime? @db.Timestamptz
  coupon        Coupon    @relation(fields: [couponId], references: [id])
  order         Order     @relation(fields: [orderId], references: [id])

  @@index([couponId, phone])
}

/// A parcel handed to a courier. The order status machine is separate: staff move the order, the shipment records where the parcel is.
model Shipment {
  id          String          @id @default(uuid()) @db.Uuid
  orderId     String          @db.Uuid
  carrier     String
  awb         String
  trackingUrl String?
  status      String          @default("BOOKED") // BOOKED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, RETURNED_TO_SELLER, FAILED
  createdBy   String
  createdAt   DateTime        @default(now()) @db.Timestamptz
  order       Order           @relation(fields: [orderId], references: [id])
  events      ShipmentEvent[]

  @@unique([carrier, awb])
  @@index([orderId])
}

model ShipmentEvent {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @db.Uuid
  status     String
  note       String?
  actor      String
  at         DateTime @default(now()) @db.Timestamptz
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  @@index([shipmentId, at])
}

/// Internal staff notes on an order. Never shown to the customer.
model OrderNote {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  author    String
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz
  order     Order    @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  updatedAt DateTime   @updatedAt @db.Timestamptz
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  variantId String         @db.Uuid
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

/// Outbox of customer messages. Rows are written in the same transaction as the order change that causes them and sent by a worker with retries.
model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  channel       String // SMS or EMAIL
  recipient     String
  template      String
  payload       Json
  status        String    @default("PENDING") // PENDING, SENT, FAILED (gave up, needs a person), SKIPPED
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz
  lastError     String?
  dedupeKey     String    @unique
  createdAt     DateTime  @default(now()) @db.Timestamptz
  sentAt        DateTime? @db.Timestamptz

  @@index([status, nextAttemptAt])
}
