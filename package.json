{
  "name": "jafson-commerce",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r --parallel --filter @jafson/api --filter @jafson/web --filter @jafson/admin dev",
    "db:setup": "pnpm --filter @jafson/api db:setup",
    "db:seed": "pnpm --filter @jafson/api db:seed"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "multer": ">=2.1.0 <3",
      "path-to-regexp": ">=8.4.0 <9",
      "effect": ">=3.20.0 <4",
      "deepmerge-ts": ">=8.0.0 <9",
      "postcss": ">=8.5.23 <9",
      "sharp": ">=0.35.5 <0.36",
      "file-type": ">=21.3.1 <22"
    }
  }
}
